{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window may call OpenDict's own commands, the core window defaults, the updater and restart, nothing else. Entry frames are sandboxed and get nothing.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-look-up",
    "allow-suggest",
    "allow-headwords-after",
    "allow-library",
    "allow-add-library-folder",
    "allow-remove-library-folder",
    "allow-rescan-library",
    "allow-set-dictionary-enabled",
    "allow-move-dictionary",
    "allow-register-dictionary",
    "allow-index-library",
    "allow-cancel-indexing",
    "allow-set-allow-network",
    "allow-appearance",
    "allow-set-theme",
    "allow-set-language",
    "allow-set-as-authored",
    "allow-set-all-as-authored",
    "allow-set-text-size",
    "allow-set-zoom",
    "allow-word-books",
    "allow-toggle-word",
    "allow-create-word-book",
    "allow-rename-word-book",
    "allow-delete-word-book",
    "allow-choose-word-book",
    "allow-remove-saved-word",
    "allow-set-word-note",
    "allow-export-word-book",
    "allow-history",
    "allow-record-lookup",
    "allow-clear-history",
    "allow-create-group",
    "allow-rename-group",
    "allow-delete-group",
    "allow-set-in-group",
    "allow-move-in-group",
    "allow-set-current-group",
    "allow-elsewhere",
    "allow-window-chrome",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "updater:default",
    "process:allow-restart"
  ]
}
