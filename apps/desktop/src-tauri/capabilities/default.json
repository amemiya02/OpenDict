{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window may call OpenDict's own commands and the core window defaults, nothing else. Entry frames are sandboxed and get nothing.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-look-up",
    "allow-library",
    "allow-add-library-folder",
    "allow-remove-library-folder",
    "allow-rescan-library",
    "allow-set-dictionary-enabled",
    "allow-move-dictionary",
    "allow-index-library",
    "allow-cancel-indexing"
  ]
}
